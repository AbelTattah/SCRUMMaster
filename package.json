    "jspdf": "^4.2.1",
    "next": "16.4.4",
    "nodemailer": "10.3.1",
    "pdfkit": "^0.20.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/nodemailer": "7.0.11",
    "@types/pdfkit": "^0.17.7",
