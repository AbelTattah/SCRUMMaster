{
    "name":  "scrum-master-desktop",
    "version":  "0.1.0",
    "private":  true,
    "description":  "Scrum Master desktop app (Electron) — runs the bundled web app locally with a fallback to the production site.",
    "license":  "UNLICENSED",
    "main":  "src/main.js",
    "scripts":  {
                    "start":  "electron .",
                    "smoke":  "electron . --smoke-test",
                    "dist":  "electron-builder",
                    "dist:win":  "electron-builder --win",
                    "dist:mac":  "electron-builder --mac",
                    "dist:linux":  "electron-builder --linux"
                },
    "devDependencies":  {
                            "electron":  "^45.2.2",
                            "electron-builder":  "^26.18.0"
                        },
    "build":  {
                  "appId":  "com.scrummaster.desktop",
                  "productName":  "Scrum Master",
                  "directories":  {
                                      "output":  "dist"
                                  },
                  "files":  [
                                "src/**/*",
                                "assets/**/*"
                            ],
                  "extraResources":  [
                                         {
                                             "from":  "../.next/standalone",
                                             "to":  "web"
                                         }
                                     ],
                  "icon":  "assets/icon.png",
                  "win":  {
                              "target":  [
                                             "nsis"
                                         ]
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true
                           },
                  "mac":  {
                              "category":  "public.app-category.productivity"
                          },
                  "linux":  {
                                "category":  "Utility"
                            }
              },
    "homepage":  "https://github.com/AbelTattah/SCRUMMaster",
    "author":  "Abel Tattah \u003cabeltattahh@gmail.com\u003e"
}
