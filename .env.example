# ---------------------------------------------------------------------------
# Scrum Master environment
# Copy this file to .env.local for local development, and configure the same
# variables in your hosting provider for production.
# ---------------------------------------------------------------------------

# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only key. NEVER expose this to the browser. It is used for account
# management, organization membership and notification jobs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public origin used for OAuth / password-recovery redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Timezone used to decide whether a task is overdue, starting soon or later
# today. Tasks only store a wall-clock time, so this must match the users'
# local timezone.
APP_TIMEZONE=Africa/Accra

# Protects /api/notifications/digest. Send it as
#   Authorization: Bearer <CRON_SECRET>
# when calling the endpoint from a scheduler.
CRON_SECRET=change-me

# ---------------------------------------------------------------------------
# Email delivery (optional)
# ---------------------------------------------------------------------------
# Leave everything empty to use the "log" transport: messages are written to
# storage/mail.log and recorded in the email_log table (useful in development).
#
# Resend: set RESEND_API_KEY and a verified MAIL_FROM address.
# SMTP:   set SMTP_HOST (and usually SMTP_PORT/SMTP_USER/SMTP_PASS).
# SMTP wins over Resend when both are configured.
MAIL_FROM=Scrum Master <no-reply@scrummaster.local>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
